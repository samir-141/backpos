  botica_id                           String             @db.Uuid
  nombre                              String             @db.VarChar(50)
  estado                              String             @default("CERRADA") @db.VarChar(20)
  created_at                          DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at                          DateTime?          @db.Timestamptz(6)
  created_by                          String?            @db.Uuid
  updated_by                          String?            @db.Uuid
  deleted_by                          String?            @db.Uuid
  version                             Int                @default(1)
  boticas                             boticas            @relation(fields: [botica_id], references: [id], onUpdate: NoAction)
  usuarios_cajas_created_byTousuarios usuarios?          @relation("cajas_created_byTousuarios", fields: [created_by], references: [id], onUpdate: NoAction)
  usuarios_cajas_deleted_byTousuarios usuarios?          @relation("cajas_deleted_byTousuarios", fields: [deleted_by], references: [id], onUpdate: NoAction)
  sucursales                          sucursales         @relation(fields: [sucursal_id], references: [id], onUpdate: NoAction)
  usuarios_cajas_updated_byTousuarios usuarios?          @relation("cajas_updated_byTousuarios", fields: [updated_by], references: [id], onUpdate: NoAction)
  movimientos_caja                    movimientos_caja[]
  ventas                              ventas[]

  @@index([botica_id], map: "idx_cajas_botica_id")
}

