# Copiar a .env y ajustar los valores locales (no versionar .env)
# DATABASE_URL y DIRECT_URL deben apuntar a la base PostgreSQL (dev/test/prod)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd?schema=public
DIRECT_URL=postgresql://usuario:password@host:5432/nombre_bd?schema=public

# Secreto JWT. OBLIGATORIO: el backend no arranca sin el (Fase 1, C-05).
JWT_SECRET=cambiar-este-secreto-en-produccion

# Expiración del token JWT (p.ej. 8h)
JWT_EXPIRES_IN=8h

# Puerto HTTP del backend
PORT=3000

# Entorno de ejecución. Usa NODE_ENV=production al desplegar. Solo en development
# se aceptan además localhost y redes LAN privadas (10.x, 172.16-31.x y 192.168.x)
# para facilitar pruebas locales/móviles.
NODE_ENV=development

# Allowlist CORS separada por comas y sin rutas. En producción enumera todos los
# orígenes HTTPS del POS y del administrador; nunca uses "*".
CORS_ORIGINS=https://pos.ejemplo.com,https://admin.ejemplo.com

# ==============================================================================
# Facturación Electrónica SUNAT
# ==============================================================================
# Clave maestra para cifrar credenciales SOL y claves de certificado (AES-256-GCM).
# OBLIGATORIA para el módulo de facturación. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Ambiente de emisión: BETA (pruebas) o PRODUCCION
SUNAT_ENVIRONMENT=BETA

# Endpoints SUNAT (valores oficiales por defecto)
SUNAT_BETA_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PROD_ENDPOINT=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# Timeout (ms) para llamadas SOAP a SUNAT
SUNAT_SOAP_TIMEOUT_MS=30000

# Directorio raíz de almacenamiento de XML/ZIP/CDR/PDF (relativo al backend)
COMPROBANTES_STORAGE_DIR=storage

# ==============================================================================
# Impresión QZ Tray (firma digital para impresión directa)
# ==============================================================================
# Ruta al certificado PEM para firmar solicitudes de QZ Tray (RSA-SHA512).
# Generar par de claves con: openssl req -x509 -newkey rsa:4096 -keyout qz-private.pem -out qz-certificate.pem -days 3650 -nodes
QZ_CERTIFICATE_PATH=./certs/qz-certificate.pem

# Ruta a la clave privada PEM para firmar solicitudes de QZ Tray.
QZ_PRIVATE_KEY_PATH=./certs/qz-private.pem

# Algoritmo de firma: RSA-SHA512 (recomendado) o RSA-SHA256
QZ_SIGNATURE_ALGORITHM=RSA-SHA512
